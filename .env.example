# Local operator/script variables. Prefer `.envrc.local` (gitignored) and never
# commit real values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=smart-home-dashboard

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Same generated value goes in Cloudflare Pages and the old Mac relay .env.
RELAY_SECRET=
RELAY_URL=https://relay.example.com
