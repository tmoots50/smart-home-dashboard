# Copy to .env on the Pi (gitignored — never commit the real one).
# Tunnel token is minted in Phase C when the Cloudflare tunnel is created;
# until it's set, install.sh starts the stack without cloudflared.
CLOUDFLARED_TUNNEL_TOKEN=
# speedtest-tracker (Laravel) app key. Generate: echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_APP_KEY=
